# Copy to .env and fill the blanks. Never commit .env.

# Supabase pooler (IPv4). The direct db host is IPv6-only.
DATABASE_URL=postgresql://rescue_worker.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Always-on worker identity. Each process needs its own id.
WORKER_ID=rescue-worker-1

# 32-byte key, base64. Used to encrypt connector credentials and phone numbers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Bolna hosted voice. Leave blank until you paste your key.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEBHOOK_SECRET=
BOLNA_TEST_PHONE=

# Sarvam planner. Leave blank until you paste your key.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Demo carrier. Set to 0 to hide the simulator routes.
DEMO_SIMULATOR=1
